# ==============================================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO - MÓDULO DE NOTIFICACIONES FONOCENTER IPS
# ==============================================================================

# Modo de Operación (true = Simulación y logs sin consumo de saldo / false = Envío real)
NOTIFICATIONS_DRY_RUN=true

# ------------------------------------------------------------------------------
# 1. CANAL CORREO ELECTRÓNICO (SMTP O SENDGRID API)
# ------------------------------------------------------------------------------
# Configuración Servidor SMTP (Gmail, Microsoft 365, Servidor Institucional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=calidad@fonocenter.com
SMTP_PASSWORD=tu_contrasena_de_aplicacion_o_token
SMTP_USE_TLS=true
EMAIL_FROM_ADDRESS=calidad@fonocenter.com
EMAIL_FROM_NAME=Comité Calidad FONOCENTER IPS

# Alternativa SendGrid API (Opcional si se usa SMTP)
SENDGRID_API_KEY=SG.tu_api_key_de_sendgrid_aqui

# ------------------------------------------------------------------------------
# 2. CANAL WHATSAPP (TWILIO O META WHATSAPP CLOUD API)
# ------------------------------------------------------------------------------
# Opción A: Proveedor Twilio WhatsApp
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=tu_auth_token_de_twilio
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Opción B: Proveedor Meta WhatsApp Cloud API Oficial (Facebook Graph API)
META_WA_PHONE_NUMBER_ID=100000000000000
META_WA_ACCESS_TOKEN=EAAG...tu_token_permanente_de_meta

# ------------------------------------------------------------------------------
# 3. CONTROL DE ACCESOS Y AUTENTICACIÓN (RBAC & SEGURIDAD)
# ------------------------------------------------------------------------------
